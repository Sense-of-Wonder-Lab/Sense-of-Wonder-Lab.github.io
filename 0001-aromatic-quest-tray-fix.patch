From 104f43fcbea10e104fcd34d2f208776a0acfdc22 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 18 Jul 2026 01:34:01 +0000
Subject: [PATCH] Show all compound/reagent cards in tray regardless of mode

Previously the tray filtered cards by each mode's progressive
availability logic, hiding most compounds/reagents until their
prerequisite reactions unlocked. Now the full roster is always listed.
---
 games/aromatic-quest/index.html | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/games/aromatic-quest/index.html b/games/aromatic-quest/index.html
index ba8f247..18289f7 100644
--- a/games/aromatic-quest/index.html
+++ b/games/aromatic-quest/index.html
@@ -889,7 +889,7 @@ function renderTray(){
   let h='';
   for(const id in COMPOUNDS){
     if(COMPOUNDS[id].start)continue;
-    if(onBoard(id))continue;
+    if(state.comp.includes(id))continue;
     h+=`<div class="tcard" data-kind="compound" data-key="${id}">`+
        `<svg viewBox="-46 -27 92 54" width="88" height="50" xmlns="http://www.w3.org/2000/svg">${structFit(id,86,48)}</svg>`+
        `<div class="tname">${COMPOUNDS[id].name}</div></div>`;
@@ -897,8 +897,6 @@ function renderTray(){
   trayComp.innerHTML=h;
   let h2='';
   for(const rg of REAGENTS){
-    const stillNeeded=REACTIONS.some(r=>(r.reagent===rg||(r.accept||[]).includes(rg))&&available(r)&&!complete(r));
-    if(!stillNeeded)continue;
     h2+=`<div class="tcard reag" data-kind="reagent" data-key="${rg}"><div class="treag">${rg}</div></div>`;
   }
   trayReag.innerHTML=h2;
--
2.43.0
